{
  "name": "project-arc",
  "version": "0.1.16",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:preview": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "server:dev": "node server/index.js"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.projectarc.game",
    "productName": "Project ARC",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.0",
    "colyseus": "^0.16.5",
    "colyseus.js": "^0.16.22",
    "express": "^5.2.1"
  }
}
